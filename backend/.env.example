# Default camera source; can also switch in Teach / Learn.
CAMERA_SOURCE=webcam
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
FRONTEND_ORIGIN=http://localhost:3000
# Set both values to enable tutorial generation. Never expose the key in frontend variables.
GEMINI_API_KEY=
# Choose an image-capable Gemini Flash model accessible to your API key. No fallback model is assumed.
GEMINI_MODEL='gemini-3.6-flash'
GEMINI_TIMEOUT_SECONDS=120
# Optional; low was validated with the selected Gemini 3.6 Flash model.
GEMINI_THINKING_LEVEL=low
